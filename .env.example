# Setelah menyalin file ini menjadi .env, isi API key di server saja.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
DEMO_MODE=true
GEMINI_TEMPERATURE=0.35
GEMINI_TOP_P=0.85
GEMINI_TOP_K=20
# Dipakai saat frontend website dan backend chatbot beda origin.
# Tidak perlu untuk pengujian lokal ketika frontend/backend berada di server sama.
CORS_ORIGINS=https://pnyupercetakan.com,https://www.pnyupercetakan.com
# Pembatas awal per alamat IP (untuk single-instance)
RATE_LIMIT_PER_10_MIN=15
